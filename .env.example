# NanoCoop Monorepo Environment Variables Example
# DO NOT COMMIT ACTUAL SECRETS

# Core Backend Configuration
NANOCOOP_CORE_PORT=8000
NANOCOOP_CORE_HOST=0.0.0.0
NANOCOOP_DB_PATH=nanocoop.db
NANOCOOP_LOG_LEVEL=INFO

# Teller App Configuration
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_CURRENCY=USD

# SMS Bridge Configuration
SMS_BRIDGE_CORE_URL=http://localhost:8000
SMS_BRIDGE_RETRY_INTERVAL_MS=3000
SMS_BRIDGE_MAX_RETRIES=5
