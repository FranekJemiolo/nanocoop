# NanoCoop Monorepo Environment Variables Template
# Copy this file to .env and supply your credentials.
# DO NOT COMMIT ACTUAL SECRETS OR LIVE API TOKENS TO SOURCE CONTROL.

# --- Core Backend Configuration ---
NANOCOOP_PORT=8000
NANOCOOP_HOST=0.0.0.0
NANOCOOP_DB_PATH=nanocoop.db
NANOCOOP_DEBUG=false
TELLER_PUBLIC_KEY=

# --- Production Telecom Integration 1: Safaricom Daraja M-Pesa ---
# Obtain from https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox                        # "sandbox" or "production"
MPESA_CONSUMER_KEY=                              # Daraja App Consumer Key
MPESA_CONSUMER_SECRET=                           # Daraja App Consumer Secret
MPESA_PASSKEY=                                   # Lipa Na M-Pesa Online passkey
MPESA_SHORTCODE=174379                           # Business Paybill or Till ShortCode
MPESA_CALLBACK_URL=https://api.nanocoop.org/api/v1/integrations/mpesa/stk-callback

# --- Production Telecom Integration 2: MTN Mobile Money Open API ---
# Obtain from https://momodeveloper.mtn.com/ (Collections product)
MTN_MOMO_ENVIRONMENT=sandbox                     # "sandbox" or "live"
MTN_MOMO_SUBSCRIPTION_KEY=                       # Primary or Secondary Subscription Key
MTN_MOMO_API_USER=                               # UUID v4 API User ID
MTN_MOMO_API_KEY=                                # Generated API Key for API User

# --- Production Telecom Integration 3: Airtel Money Africa ---
# Obtain from https://developers.airtel.africa/
AIRTEL_ENVIRONMENT=staging                         # "staging" or "production"
AIRTEL_CLIENT_ID=                                  # Airtel Developer Client ID
AIRTEL_CLIENT_SECRET=                              # Airtel Developer Client Secret
AIRTEL_COUNTRY=KE                                  # Default country code (e.g. KE, UG, TZ, RW, NG, ZM)
AIRTEL_CURRENCY=KES                                # Default currency (e.g. KES, UGX, TZS, RWF, NGN, ZMW)

# --- Production Telecom Integration 4: Orange Money Africa ---
# Obtain from https://developer.orange.com/apis/om-webpay/
ORANGE_ENVIRONMENT=sandbox                         # "sandbox" or "production"
ORANGE_CLIENT_ID=                                  # Orange Developer Client ID
ORANGE_CLIENT_SECRET=                              # Orange Developer Client Secret
ORANGE_MERCHANT_KEY=                               # Orange Money Merchant Key

# --- Production Telecom Integration 5: Wave Mobile Money ---
# Obtain from https://docs.wave.com/
WAVE_ENVIRONMENT=sandbox                           # "sandbox" or "live"
WAVE_API_KEY=                                      # Wave Secret API Key
WAVE_WEBHOOK_SECRET=                               # Wave Webhook HMAC-SHA256 Signing Secret

# --- Production Telecom Integration 6: Africa's Talking Cloud SMS ---
# Obtain from https://africastalking.com/
AFRICASTALKING_USERNAME=sandbox                  # "sandbox" or production username
AFRICASTALKING_API_KEY=                          # Live or Sandbox API Key
AFRICASTALKING_SENDER_ID=                        # Approved Alphanumeric Sender ID / Shortcode

# --- Server Key for Automated Webhook Event Signing ---
# Optional 64-char hex private key used by server to cryptographically sign verified telecom callbacks
GATEWAY_PRIVATE_KEY=

# --- Cross-Platform Teller App (Expo SDK 51) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_CURRENCY=USD

# --- Android SMS Bridge Gateway ---
SMS_BRIDGE_CORE_URL=http://localhost:8000
SMS_BRIDGE_RETRY_INTERVAL_MS=3000
SMS_BRIDGE_MAX_RETRIES=5
